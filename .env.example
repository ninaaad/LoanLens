# All optional. With no DATABASE_URL the API starts its own embedded Postgres in .data/pg.
# DATABASE_URL=postgres://postgres:loanlens@localhost:5432/loanlens
PORT=4000
# Simulated provider latency is shrunk by this factor so demos stay snappy (recorded latency stays nominal).
LATENCY_SCALE=0.02
# LLM_PROVIDER=none|anthropic   (none = template summaries, no key needed)
# ANTHROPIC_API_KEY=
